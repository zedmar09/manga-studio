{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/setup-payoff.schema.json",
  "title": "Manga Studio Setup And Payoff", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "setup_payoff_id", "description", "setup_scene_ids", "payoff_scene_ids", "state", "expected_payoff", "plot_thread_ids", "status", "basis"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "setup_payoff_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "description": {"type": "string", "minLength": 1}, "setup_scene_ids": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "payoff_scene_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "state": {"enum": ["setup_only", "partial_payoff", "paid_off", "abandoned", "unknown"]},
    "expected_payoff": {"type": "string"}, "plot_thread_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "status": {"$ref": "story-common.schema.json#/$defs/canonStatus"}, "basis": {"$ref": "story-common.schema.json#/$defs/evidenceOrDecision"}
  }
}
