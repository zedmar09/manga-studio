{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/canon.schema.json",
  "title": "Manga Studio Story Canon", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "canon_id", "version", "status", "confirmed_facts", "provisional_facts", "inferred_facts", "contradictions", "deprecated_facts", "unknowns"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "canon_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "version": {"type": "string"}, "status": {"enum": ["draft", "proposed", "approved", "superseded"]},
    "confirmed_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "provisional_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "inferred_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "contradictions": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "deprecated_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}, "unknowns": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
  },
  "$defs": {
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "subject_id", "predicate", "value", "status", "basis"],
      "properties": {
        "fact_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "subject_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
        "predicate": {"type": "string", "minLength": 1}, "value": {}, "status": {"$ref": "story-common.schema.json#/$defs/canonStatus"},
        "basis": {"$ref": "story-common.schema.json#/$defs/evidenceOrDecision"}
      }
    }
  }
}
