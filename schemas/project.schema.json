{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manga-studio.local/schemas/project.schema.json",
  "title": "Portable Manga Studio Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "title", "source_language", "output_language",
    "project_type", "genre", "source_roots", "source_inclusion_patterns",
    "source_exclusion_patterns", "chapter_detection_strategy",
    "existing_structure_preservation", "revision_mode", "author_voice_preservation",
    "reading_direction", "target_manga_format", "workflow_phase", "operating_mode",
    "stage_locks", "stage_lock_records", "image_generation_enabled", "active_manuscript_version",
    "active_canon_version", "active_storyboard_version", "blocking_reasons"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 2},
    "output_language": {"type": "string", "minLength": 2},
    "project_type": {"type": "string", "enum": ["new_story", "existing_story", "mixed_sources"]},
    "genre": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}},
    "source_inclusion_patterns": {"type": "array", "items": {"type": "string"}},
    "source_exclusion_patterns": {"type": "array", "items": {"type": "string"}},
    "chapter_detection_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "filename_patterns", "heading_levels", "require_review_on_ambiguity"],
      "properties": {
        "mode": {"type": "string", "enum": ["auto", "single_document", "file_per_chapter", "headings", "manual"]},
        "filename_patterns": {"type": "array", "items": {"type": "string"}},
        "heading_levels": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "require_review_on_ambiguity": {"type": "boolean"}
      }
    },
    "existing_structure_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_original_paths", "preserve_chapter_order", "preserve_titles", "never_rewrite_originals"],
      "properties": {
        "preserve_original_paths": {"type": "boolean"},
        "preserve_chapter_order": {"type": "boolean"},
        "preserve_titles": {"type": "boolean"},
        "never_rewrite_originals": {"const": true}
      }
    },
    "revision_mode": {"type": "string", "enum": ["proposal_only", "approved_versions_only", "direct_draft_versions"]},
    "author_voice_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "notes"],
      "properties": {"required": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}
    },
    "reading_direction": {"type": "string", "enum": ["right-to-left", "left-to-right"]},
    "target_manga_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color_mode", "page_width_px", "page_height_px"],
      "properties": {
        "color_mode": {"type": "string", "enum": ["black-and-white", "grayscale", "color"]},
        "page_width_px": {"type": "integer", "minimum": 1},
        "page_height_px": {"type": "integer", "minimum": 1},
        "output_intent": {"type": "string", "enum": ["screen", "print", "both"]},
        "print_profile": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/printProfile"}
          ]
        }
      }
    },
    "workflow_phase": {"type": "string", "minLength": 1},
    "operating_mode": {
      "type": "string",
      "enum": ["create_new", "import_existing", "diagnose_existing", "repair_existing", "continue_existing", "adapt_existing_to_manga", "continuity_audit", "prepare_visual_production"]
    },
    "stage_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SOURCE_LOCKED", "CANON_APPROVED", "DIAGNOSTIC_APPROVED", "REVISION_PLAN_APPROVED", "MANUSCRIPT_APPROVED", "STORY_LOCKED", "STORYBOARD_APPROVED", "STORYBOARD_LOCKED", "IMAGE_READY"],
      "properties": {
        "SOURCE_LOCKED": {"type": "boolean"}, "CANON_APPROVED": {"type": "boolean"},
        "DIAGNOSTIC_APPROVED": {"type": "boolean"}, "REVISION_PLAN_APPROVED": {"type": "boolean"},
        "MANUSCRIPT_APPROVED": {"type": "boolean"}, "STORY_LOCKED": {"type": "boolean"},
        "STORYBOARD_APPROVED": {"type": "boolean"}, "STORYBOARD_LOCKED": {"type": "boolean"},
        "IMAGE_READY": {"type": "boolean"}
      }
    },
    "stage_lock_records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SOURCE_LOCKED", "CANON_APPROVED", "DIAGNOSTIC_APPROVED", "REVISION_PLAN_APPROVED", "MANUSCRIPT_APPROVED", "STORY_LOCKED", "STORYBOARD_APPROVED", "STORYBOARD_LOCKED", "IMAGE_READY"],
      "properties": {
        "SOURCE_LOCKED": {"$ref": "#/$defs/nullableRelativePath"},
        "CANON_APPROVED": {"$ref": "#/$defs/nullableRelativePath"},
        "DIAGNOSTIC_APPROVED": {"$ref": "#/$defs/nullableRelativePath"},
        "REVISION_PLAN_APPROVED": {"$ref": "#/$defs/nullableRelativePath"},
        "MANUSCRIPT_APPROVED": {"$ref": "#/$defs/nullableRelativePath"},
        "STORY_LOCKED": {"$ref": "#/$defs/nullableRelativePath"},
        "STORYBOARD_APPROVED": {"$ref": "#/$defs/nullableRelativePath"},
        "STORYBOARD_LOCKED": {"$ref": "#/$defs/nullableRelativePath"},
        "IMAGE_READY": {"$ref": "#/$defs/nullableRelativePath"}
      }
    },
    "image_generation_enabled": {"type": "boolean", "default": false},
    "active_manuscript_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "active_canon_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "active_storyboard_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "active_creative_brief_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "active_success_plan_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "active_nemu_version": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!~)(?!.*(^|/)\\.\\.(?:/|$)).+"},
    "nullableRelativePath": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "printProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "unit", "dpi", "trim_width", "trim_height", "bleed",
        "safe_margin", "binding", "inner_gutter", "page_side", "export_format",
        "crop_marks", "color_profile"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "enum": ["mm", "in"]},
        "dpi": {"type": "integer", "minimum": 72, "maximum": 2400},
        "trim_width": {"type": "number", "minimum": 0.01},
        "trim_height": {"type": "number", "minimum": 0.01},
        "bleed": {"$ref": "#/$defs/edgeMeasurements"},
        "safe_margin": {"$ref": "#/$defs/edgeMeasurements"},
        "binding": {"type": "string", "enum": ["none", "perfect", "saddle_stitch", "case_bound", "digital"]},
        "inner_gutter": {"type": "number", "minimum": 0},
        "page_side": {"type": "string", "enum": ["auto", "left", "right", "single"]},
        "export_format": {"type": "string", "enum": ["pdf", "png", "tiff"]},
        "crop_marks": {"type": "boolean"},
        "color_profile": {"type": "string", "minLength": 1}
      }
    },
    "edgeMeasurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "number", "minimum": 0},
        "right": {"type": "number", "minimum": 0},
        "bottom": {"type": "number", "minimum": 0},
        "left": {"type": "number", "minimum": 0}
      }
    }
  }
}
