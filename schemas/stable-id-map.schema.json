{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manga-studio.local/schemas/stable-id-map.schema.json",
  "title": "Manga Studio Stable ID Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "namespaces"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project_id": {"type": "string"},
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_documents", "chapters", "scenes", "characters", "locations", "organizations", "props", "timeline_events", "plot_threads", "setups_payoffs"],
      "properties": {
        "source_documents": {"type": "array", "items": {"type": "object"}},
        "chapters": {"type": "array", "items": {"type": "object"}},
        "scenes": {"type": "array", "items": {"type": "object"}},
        "characters": {"type": "array", "items": {"type": "object"}},
        "locations": {"type": "array", "items": {"type": "object"}},
        "organizations": {"type": "array", "items": {"type": "object"}},
        "props": {"type": "array", "items": {"type": "object"}},
        "timeline_events": {"type": "array", "items": {"type": "object"}},
        "plot_threads": {"type": "array", "items": {"type": "object"}},
        "setups_payoffs": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
