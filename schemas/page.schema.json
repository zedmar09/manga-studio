{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manga-studio.local/schemas/page.schema.json",
  "title": "Manga Studio Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_id",
    "page_number",
    "status",
    "reading_order",
    "page_size",
    "panels",
    "lettering"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft_waiting_for_art",
        "ready_for_composition",
        "composed",
        "lettered",
        "exported"
      ]
    },
    "reading_order": {
      "type": "string",
      "enum": [
        "right-to-left",
        "left-to-right"
      ]
    },
    "page_size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "enum": [
            "px"
          ]
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "panel.schema.json"
      }
    },
    "lettering": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/letteringItem"
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "letteringItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "kind",
        "text",
        "box"
      ],
      "properties": {
        "panel_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "speech",
            "caption",
            "thought"
          ]
        },
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "tail_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
