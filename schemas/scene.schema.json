{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/scene.schema.json",
  "title": "Manga Studio Scene", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "scene_id", "chapter_id", "display_title", "source_order", "purpose", "summary", "location_ids", "character_ids", "prop_ids", "timeline_event_ids", "entry_state", "exit_state", "status", "evidence"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "scene_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "chapter_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "display_title": {"type": "string"}, "source_order": {"type": "integer", "minimum": 1}, "purpose": {"type": "string"}, "summary": {"type": "string"},
    "location_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "character_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "prop_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "timeline_event_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "entry_state": {"type": "object"}, "exit_state": {"type": "object"}, "status": {"$ref": "story-common.schema.json#/$defs/canonStatus"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}}
  }
}
