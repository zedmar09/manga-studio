{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/revision-plan.schema.json",
  "title": "Manga Studio Revision Plan", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision_plan_id", "version", "revision_policy_id", "target_stable_ids", "triggering_issue_ids", "source_evidence", "proposed_operation", "expected_result", "alternatives", "preserve", "author_voice_impact", "canon_impact", "continuity_impact", "structural_impact", "dependencies", "acceptance_criteria", "change_set_ids", "approval_status"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "revision_plan_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "version": {"type": "string"}, "revision_policy_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "target_stable_ids": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "triggering_issue_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}}, "proposed_operation": {"type": "string"}, "expected_result": {"type": "string"},
    "alternatives": {"type": "array", "items": {"type": "string"}}, "preserve": {"type": "array", "items": {"type": "string"}},
    "author_voice_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "canon_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "continuity_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "structural_impact": {"$ref": "story-common.schema.json#/$defs/impact"},
    "dependencies": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "change_set_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "approval_status": {"enum": ["proposed", "approved", "rejected", "superseded"]}
  }
}
