{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manga-studio.local/schemas/character.schema.json",
  "title": "Manga Studio Character",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_id",
    "display_name",
    "role",
    "locked_reference_images",
    "visual_identity",
    "continuity_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "locked_reference_images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "visual_identity": {
      "type": "object"
    },
    "continuity_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dramatic_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_goal", "internal_need", "core_fear", "stakes", "flaw",
        "contradiction", "moral_limits", "arc_direction", "voice_principles",
        "relationship_drivers"
      ],
      "properties": {
        "external_goal": {"type": "string", "minLength": 1},
        "internal_need": {"type": "string", "minLength": 1},
        "core_fear": {"type": "string", "minLength": 1},
        "stakes": {"type": "string", "minLength": 1},
        "flaw": {"type": "string", "minLength": 1},
        "contradiction": {"type": "string", "minLength": 1},
        "moral_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "arc_direction": {"type": "string", "minLength": 1},
        "voice_principles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "relationship_drivers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+"
    }
  }
}
