{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manga-studio.local/schemas/creative-brief.schema.json",
  "title": "Manga Studio Creative Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "brief_id", "version", "status", "premise",
    "core_message", "thematic_question", "intended_reader_takeaway", "story_promise",
    "target_audience", "genre", "tone", "target_length", "opening_strategy",
    "structure_strategy", "originality", "show_dont_tell_policy", "basis"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "brief_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "version": {"type": "string", "pattern": "^v[0-9]{3}$"},
    "status": {"enum": ["draft", "proposed", "approved", "superseded"]},
    "premise": {"type": "string", "minLength": 1},
    "core_message": {"type": "string", "minLength": 1},
    "thematic_question": {"type": "string", "minLength": 1},
    "intended_reader_takeaway": {"type": "string", "minLength": 1},
    "story_promise": {"type": "string", "minLength": 1},
    "target_audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age_band", "content_rating", "content_boundaries", "sensitivity_requirements", "accessibility_goals"],
      "properties": {
        "age_band": {"type": "string", "minLength": 1},
        "content_rating": {"enum": ["all_ages", "teen", "older_teen", "mature", "unrated_pending_review"]},
        "content_boundaries": {"type": "array", "items": {"type": "string"}},
        "sensitivity_requirements": {"type": "array", "items": {"type": "string"}},
        "accessibility_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "genre": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "tone": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "minimum", "maximum", "flexible"],
      "properties": {
        "unit": {"enum": ["pages", "chapters", "episodes", "scenes", "custom"]},
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1},
        "flexible": {"type": "boolean"}
      }
    },
    "opening_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "hook", "first_page_promise", "rationale"],
      "properties": {
        "mode": {"enum": ["needle_drop", "character_disruption", "mystery_question", "slow_burn", "world_promise", "source_preserved", "custom"]},
        "hook": {"type": "string", "minLength": 1},
        "first_page_promise": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "structure_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "rationale", "flexible", "beats"],
      "properties": {
        "framework": {"enum": ["kishotenketsu", "three_act", "five_act", "hero_journey", "episodic", "anthology", "source_preserved", "custom"]},
        "rationale": {"type": "string", "minLength": 1},
        "flexible": {"type": "boolean"},
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "purpose", "expected_turn"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "expected_turn": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "originality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparables", "differentiators", "prohibited_derivation"],
      "properties": {
        "comparables": {"type": "array", "items": {"type": "string"}},
        "differentiators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_derivation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "show_dont_tell_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualizable_information", "dialogue_only_when", "exposition_limits", "silence_opportunities"],
      "properties": {
        "visualizable_information": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dialogue_only_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exposition_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "silence_opportunities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_evidence", "decision_ids"],
      "properties": {
        "source_evidence": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}},
        "decision_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}
      }
    }
  }
}
