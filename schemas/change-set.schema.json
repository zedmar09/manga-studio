{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/change-set.schema.json",
  "title": "Manga Studio Change Set", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "change_set_id", "version", "revision_policy_id", "revision_plan_id", "target_stable_ids", "triggering_issue_ids", "source_evidence", "operation", "expected_result", "alternatives", "preserve", "author_voice_impact", "canon_impact", "continuity_impact", "structural_impact", "dependencies", "acceptance_criteria", "approval_status"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "change_set_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "version": {"type": "string"}, "revision_policy_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "revision_plan_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "target_stable_ids": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "triggering_issue_ids": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}}, "operation": {"$ref": "#/$defs/operation"}, "expected_result": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "items": {"type": "string"}}, "preserve": {"type": "array", "items": {"type": "string"}},
    "author_voice_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "canon_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "continuity_impact": {"$ref": "story-common.schema.json#/$defs/impact"}, "structural_impact": {"$ref": "story-common.schema.json#/$defs/impact"},
    "dependencies": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval_status": {"enum": ["proposed", "approved", "rejected", "superseded"]}
  },
  "$defs": {
    "operation": {"type": "object", "required": ["type", "target_relative_path", "target_sha256"], "properties": {
      "type": {"enum": ["replace_text", "append_text", "insert_after"]}, "target_relative_path": {"$ref": "story-common.schema.json#/$defs/relativePath"}, "target_sha256": {"$ref": "story-common.schema.json#/$defs/sha256"},
      "before": {"type": "string"}, "after": {"type": "string"}, "anchor": {"type": "string"}, "text": {"type": "string"}
    }}
  }
}
