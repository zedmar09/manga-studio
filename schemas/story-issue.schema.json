{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/story-issue.schema.json",
  "title": "Manga Studio Story Issue", "type": "object", "additionalProperties": false,
  "required": ["issue_id", "category", "severity", "confidence", "status", "description", "why_it_matters", "evidence", "affected_chapter_ids", "affected_scene_ids", "related_ids", "alternatives", "uncertainty", "adaptation_impact"],
  "properties": {
    "issue_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "category": {"type": "string", "enum": ["plot_logic", "causality", "timeline", "character_knowledge", "character_motivation", "character_arc", "relationship_continuity", "world_rule_continuity", "prop_continuity", "injury_physical_state_continuity", "pacing", "duplicated_scene_purpose", "exposition", "dialogue_voice", "setup_payoff", "unresolved_plot_thread", "chapter_opening", "chapter_ending", "manga_adaptation_risk"]},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["open", "accepted", "rejected", "resolved", "deferred", "needs_review"]}, "description": {"type": "string", "minLength": 1}, "why_it_matters": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}},
    "affected_chapter_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "affected_scene_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "related_ids": {"type": "object", "additionalProperties": false, "required": ["character_ids", "location_ids", "prop_ids", "timeline_event_ids", "plot_thread_ids"], "properties": {
      "character_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "location_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "prop_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "timeline_event_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "plot_thread_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}
    }},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "uncertainty": {"type": "string"}, "adaptation_impact": {"type": "string"}
  }
}
