{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://manga-studio.local/schemas/chapter.schema.json",
  "title": "Manga Studio Chapter", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "chapter_id", "display_title", "aliases", "source_order", "document_ids", "scene_ids", "opening_function", "ending_function", "summary", "status", "evidence"],
  "properties": {
    "schema_version": {"$ref": "story-common.schema.json#/$defs/schemaVersion"}, "project_id": {"$ref": "story-common.schema.json#/$defs/stableId"}, "chapter_id": {"$ref": "story-common.schema.json#/$defs/stableId"},
    "display_title": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}}, "source_order": {"type": "integer", "minimum": 1},
    "document_ids": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/stableId"}}, "scene_ids": {"type": "array", "items": {"$ref": "story-common.schema.json#/$defs/stableId"}},
    "opening_function": {"type": "string"}, "ending_function": {"type": "string"}, "summary": {"type": "string"}, "status": {"$ref": "story-common.schema.json#/$defs/canonStatus"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "story-common.schema.json#/$defs/evidenceLocator"}}
  }
}
